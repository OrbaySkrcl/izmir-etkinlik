# --- Telegram (zorunlu) ---
# BotFather'dan (@BotFather) /newbot ile alın.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenBuraya
# /tara komutunu ve kaynak uyarılarını alacak kullanıcı id'leri (virgülle ayrılmış).
# Kendi id'nizi @userinfobot'a yazarak öğrenebilirsiniz.
TELEGRAM_ADMIN_IDS=

# --- Veritabanı ---
# Railway'de Postgres eklerseniz DATABASE_URL otomatik gelir; bu satırı silin.
# Yerelde SQLite yeterlidir.
DATABASE_URL=sqlite+aiosqlite:///data/izmir_events.db

# --- Toplama ---
SCRAPE_INTERVAL_MINUTES=180     # kaç dakikada bir tarama (0 = kapalı)
SCRAPE_ON_STARTUP=true
HTTP_CONCURRENCY=4              # eşzamanlı istek sayısı
HTTP_DELAY_SECONDS=1.0          # aynı siteye istekler arası bekleme (nazik olun)
HTTP_TIMEOUT=25
HTTP_MAX_RETRIES=3
HTTP_CACHE_TTL_MINUTES=30
RESPECT_ROBOTS=true             # robots.txt'e uy (üretimde açık bırakın)

# --- Tekilleştirme ---
DEDUP_THRESHOLD=0.82            # 0-1; düşürürsen daha çok birleşir, yükseltirsen daha az
DEDUP_DATE_TOLERANCE_DAYS=1

# --- Bülten ---
DIGEST_HOUR=9                   # Europe/Istanbul saatiyle
DIGEST_MINUTE=0
MAX_EVENTS_PER_MESSAGE=25

# --- Webhook (opsiyonel; boşsa long polling kullanılır) ---
# Railway'de servisinize bir domain atadıysanız buraya yazın.
WEBHOOK_URL=
WEBHOOK_SECRET=
PORT=8080

# --- Diğer ---
LOG_LEVEL=INFO
TIMEZONE=Europe/Istanbul
# Sadece belirli kaynakları taramak için: ONLY_SOURCES=bubilet,biletinial
ONLY_SOURCES=
